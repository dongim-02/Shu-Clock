# 이 파일을 .env 로 복사한 뒤 값을 채우세요 (.env 는 git 에 올리지 않습니다)
MONGO_URI=mongodb://localhost:27017
DB_NAME=bus_tracking

# 24자 이상 임의 문자열. 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# 쉼표로 구분. 비워두면 제한 없음 (운영 시에는 채우는 것을 권장)
ALLOWED_RECEIVERS=RX-01,RX-02
ALLOWED_BUS_MACS=

# production 이면 /docs 비활성화
APP_ENV=development